generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum TeacherShift {
  DAY   // 1 PM - 9 PM PKT
  NIGHT // 9 PM - 4 AM PKT
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?
  name          String
  password      String
  loginPassword String?  // admin-visible plaintext copy of the issued login password (internal academy use)
  role          Role     @default(STUDENT)
  shift         TeacherShift? // for teachers: DAY or NIGHT
  gender        Gender?       // for teachers: MALE or FEMALE
  image         String?
  country       String?
  address       String?   // full address (street, city, postal) — for teacher profiles
  timezone      String?
  bio           String?
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  studentEnrollments    Enrollment[]    @relation("StudentEnrollments")
  teacherCourses        Course[]        @relation("CoursePrimaryTeacher")
  courseTeacherships    CourseTeacher[] @relation("TeacherCourseTeachers")
  taughtEnrollments     Enrollment[]    @relation("EnrollmentTeacher")
  availability          UserAvailability[]
  teacherBookings       BookingSlot[]   @relation("TeacherBookings")
  trialAssignments      TrialAssignment[] @relation("TrialTeacher")
  files                 TeacherFile[]
  lessonAssignments     LessonAssignment[] @relation("LessonAssignedTo")
  bookingAttendance     BookingAttendance[] @relation("BookingAttendanceStudent")
  workdayAttendance     TeacherAttendance[] @relation("TeacherWorkdayAttendance")
  parentChildren        ParentChild[]   @relation("Parent")
  childOfParents        ParentChild[]   @relation("Child")
  attendanceRecords     Attendance[]
  sentMessages          Message[]       @relation("MessageSender")
  receivedMessages      Message[]       @relation("MessageReceiver")
  sessions              Session[]
}

model BookingSlot {
  id           String   @id @default(cuid())
  enrollmentId String
  teacherId    String
  dayOfWeek    Int      // 0=Sun ... 6=Sat
  startTime    String   // "HH:MM" in PKT (Asia/Karachi)
  duration     Int      @default(30) // minutes
  createdAt    DateTime @default(now())

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher      User       @relation("TeacherBookings", fields: [teacherId], references: [id], onDelete: Cascade)
  attendance   BookingAttendance[]

  // A teacher can't be double-booked at the same day+time
  @@unique([teacherId, dayOfWeek, startTime])
  @@index([enrollmentId])
  @@index([teacherId])
}

// Per-date attendance for a recurring BookingSlot occurrence.
// Date is stored as midnight UTC for the PKT calendar day (to keep
// one record per (booking, day)).
model BookingAttendance {
  id            String           @id @default(cuid())
  bookingSlotId String
  studentId     String
  date          DateTime         // PKT calendar day at 00:00 UTC
  status        AttendanceStatus
  markedAt      DateTime         @default(now())

  bookingSlot BookingSlot @relation(fields: [bookingSlotId], references: [id], onDelete: Cascade)
  student     User        @relation("BookingAttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([bookingSlotId, date])
  @@index([studentId])
  @@index([date])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  level         String   // Beginner / Intermediate / Advanced
  duration      String?  // e.g. "6-8 months" (course length)
  classDuration Int      @default(45) // single class length in minutes (e.g. 30 or 45)
  price         Float    @default(0)
  image       String?
  meetingUrl  String?  // one persistent meeting link for this course (admin override; auto-generated if empty)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Primary teacher (legacy / lead instructor)
  teacherId   String?
  teacher     User?    @relation("CoursePrimaryTeacher", fields: [teacherId], references: [id])

  // Additional teachers (many-to-many via join table)
  courseTeachers CourseTeacher[]

  enrollments Enrollment[]
  classes     Class[]
  lessons     Lesson[]
}

model CourseTeacher {
  id        String @id @default(cuid())
  courseId  String
  teacherId String

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User   @relation("TeacherCourseTeachers", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([teacherId])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  content     String?  @db.Text // Markdown / HTML body
  videoUrl    String?
  audioUrl    String?
  fileUrl     String?
  duration    Int?     // estimated minutes
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
  assignments LessonAssignment[]

  @@index([courseId, order])
}

// Teacher assigns a specific lesson to specific student(s) of the course.
// Only assigned students see the lesson in their panel.
model LessonAssignment {
  id         String   @id @default(cuid())
  lessonId   String
  studentId  String
  assignedAt DateTime @default(now())

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student User   @relation("LessonAssignedTo", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  lessonId    String
  studentId   String
  completedAt DateTime @default(now())

  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  teacherId String?  // specific teacher within the course teaching this student
  progress  Int      @default(0) // percentage 0-100
  startedAt DateTime @default(now())
  status    String   @default("active") // active / paused / completed

  student      User                     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  course       Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher      User?                    @relation("EnrollmentTeacher", fields: [teacherId], references: [id])
  availability EnrollmentAvailability[]
  bookings     BookingSlot[]

  @@unique([studentId, courseId])
  @@index([teacherId])
}

model EnrollmentAvailability {
  id           String @id @default(cuid())
  enrollmentId String
  dayOfWeek    Int    // 0=Sun, ..., 6=Sat
  startTime    String // "HH:MM" 24-hour (in student's timezone)
  endTime      String // "HH:MM"

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model Class {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  startTime   DateTime
  duration    Int      // minutes
  meetingUrl  String?
  recordingUrl String?
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendance  Attendance[]
}

model Attendance {
  id        String           @id @default(cuid())
  classId   String
  studentId String
  status    AttendanceStatus
  markedAt  DateTime         @default(now())

  class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
}

model ParentChild {
  id       String @id @default(cuid())
  parentId String
  childId  String

  parent   User @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  child    User @relation("Child", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model UserAvailability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime String   // "HH:MM" 24-hour format (in user's own timezone)
  endTime   String   // "HH:MM"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Admin's manual assignment of a website trial request to a specific teacher.
// The trial itself lives in MongoDB (developer's backend); we key by its _id.
model TrialAssignment {
  id                String   @id @default(cuid())
  mongoEnrollmentId String   @unique
  teacherId         String
  trialTime         DateTime // copy of MongoDB trialTime for fast conflict checks
  assignedAt        DateTime @default(now())

  teacher User @relation("TrialTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([trialTime])
}

// PDFs / docs uploaded for a teacher's profile (certificates, resume, etc.)
// Files live on Vercel Blob; we store the URL + metadata.
model TeacherFile {
  id         String   @id @default(cuid())
  userId     String
  kind       String   // "resume" | "certificate" | "other"
  name       String   // display label
  url        String   // Vercel Blob URL (public)
  mimeType   String?
  size       Int?
  uploadedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Teacher's daily workday sign-in / sign-out (separate from auth login).
// Teacher clicks "Sign In" when starting their day and "Sign Out" when done.
// Admin sees the record per teacher per day with total hours.
model TeacherAttendance {
  id        String    @id @default(cuid())
  teacherId String
  date      DateTime  // PKT calendar day at 00:00 UTC
  signInAt  DateTime
  signOutAt DateTime?

  teacher User @relation("TeacherWorkdayAttendance", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([date])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}
