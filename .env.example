# PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public&connect_timeout=15"

# NextAuth
NEXTAUTH_SECRET="replace-with-random-long-secret"
NEXTAUTH_URL="http://localhost:3000"

# Blob storage
BLOB_READ_WRITE_TOKEN="vercel_blob_token_here"

# Email
RESEND_API_KEY="re_your_key_here"

# Cron job auth (any random string; set same value in Vercel env vars)
CRON_SECRET="replace-with-random-secret"
